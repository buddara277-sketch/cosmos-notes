{
  "expo": {
    "name": "Cosmos Notes",
    "slug": "cosmos-notes-deepseek",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Неоновая планета с кольцами.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.cosmosa27.cosmosnotes",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Неоновая планета с кольцами.png",
        "backgroundColor": "#05091D"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cosmos Notes использует микрофон для голосового ввода заметок.",
          "speechRecognitionPermission": "Cosmos Notes использует распознавание речи для создания заметок.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f90f8d34-78f5-4ad7-a449-7cd46b9c3469"
      }
    }
  }
}
